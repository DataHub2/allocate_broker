# Postgres. Lämna tomt lokalt, då används en inbyggd databas i .data/.
DATABASE_URL=

# Krävs för AI-delarna i produktion. DeepSeek används om den nyckeln finns, annars Claude.
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# Kommaseparerade e-postadresser som får administrera företag.
ADMIN_EMAILS=

# Webbadressen till sajten, används i länkar i mejl.
SITE_URL=http://localhost:3100

# Skickar mejl om lösenordsåterställning. Utan nyckel skrivs länken till serverloggen.
RESEND_API_KEY=
MAIL_FROM=

# Lokal utveckling utan AI-kostnad. Ignoreras i produktion.
AI_FAKE=
